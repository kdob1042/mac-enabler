{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "profile_order": [
    "luna_max",
    "astra_light"
  ],
  "profiles": {
    "luna_max": {
      "display_name": "Luna Max",
      "cost_tier": "maximum",
      "purpose": "既存ソースとの関係の解析、変更箇所の特定、分類、状態確認、簡単な実装",
      "reasoning_depth": "maximum"
    },
    "astra_light": {
      "display_name": "Astra Light",
      "cost_tier": "low",
      "purpose": "難しい設計、難しい実装、重大な破壊リスクを伴う判断",
      "reasoning_depth": "light"
    }
  },
  "bindings": {
    "luna_max": {
      "cli_profile": "luna_max",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "xhigh"
    },
    "astra_light": {
      "cli_profile": "astra_light",
      "model": "gpt-6-astra",
      "reasoning_effort": "low"
    }
  },
  "phase_profiles": {
    "source_analysis": "luna_max",
    "architecture": "astra_light",
    "implementation": "luna_max",
    "verification": "luna_max",
    "handoff": "luna_max"
  },
  "routes": [
    {
      "id": "source-analysis",
      "profile": "luna_max",
      "keywords": [
        "source analysis",
        "existing source",
        "trace",
        "locate",
        "impact",
        "既存ソース",
        "コードを読む",
        "変更箇所",
        "影響範囲",
        "関連箇所",
        "依存関係",
        "探索",
        "解析"
      ]
    },
    {
      "id": "architecture",
      "profile": "astra_light",
      "keywords": [
        "architecture",
        "design",
        "system design",
        "設計",
        "全体構成",
        "正本",
        "データモデル",
        "責務分担"
      ]
    },
    {
      "id": "complex-implementation",
      "profile": "astra_light",
      "keywords": [
        "complex implementation",
        "difficult implementation",
        "large refactor",
        "複雑な実装",
        "難しい実装",
        "大規模改修",
        "大規模な変更",
        "複雑なリファクタリング"
      ]
    },
    {
      "id": "incident-analysis",
      "profile": "luna_max",
      "keywords": [
        "incident",
        "regression",
        "debug",
        "障害",
        "不具合",
        "原因調査",
        "壊れた",
        "復旧"
      ]
    },
    {
      "id": "review-analysis",
      "profile": "luna_max",
      "keywords": [
        "review",
        "audit",
        "レビュー",
        "監査",
        "差分確認",
        "コードレビュー"
      ]
    },
    {
      "id": "implementation",
      "profile": "luna_max",
      "keywords": [
        "implement",
        "implementation",
        "feature",
        "実装",
        "改修",
        "機能追加"
      ]
    },
    {
      "id": "verification",
      "profile": "luna_max",
      "keywords": [
        "test",
        "verify",
        "validation",
        "検証",
        "テスト",
        "確認"
      ]
    },
    {
      "id": "documentation",
      "profile": "luna_max",
      "keywords": [
        "document",
        "docs",
        "documentation",
        "文書",
        "設計書",
        "README"
      ]
    },
    {
      "id": "triage",
      "profile": "luna_max",
      "keywords": [
        "triage",
        "classify",
        "list",
        "status",
        "分類",
        "一覧",
        "状態確認",
        "要約",
        "整理"
      ]
    },
    {
      "id": "handoff",
      "profile": "luna_max",
      "keywords": [
        "handoff",
        "checkpoint",
        "compact",
        "引き継ぎ",
        "チェックポイント",
        "コンパクション"
      ]
    }
  ],
  "guardrails": [
    {
      "id": "data-loss-or-production",
      "minimum_profile": "astra_light",
      "keywords": [
        "production",
        "本番",
        "delete",
        "deletion",
        "削除",
        "破壊",
        "data loss",
        "データ消失",
        "credential",
        "secret",
        "認証情報",
        "秘密情報",
        "課金"
      ]
    },
    {
      "id": "migration-or-public-contract",
      "minimum_profile": "astra_light",
      "keywords": [
        "migration",
        "migrate",
        "移行",
        "schema",
        "スキーマ",
        "公開API",
        "public api",
        "互換性"
      ]
    }
  ],
  "fallback": {
    "route": "implementation",
    "profile": "luna_max"
  },
  "enforcement": {
    "policy": "Use Luna Max for source analysis and simple implementation; after compaction, use Astra Light for difficult design or implementation and Luna Max for simple implementation.",
    "chatgpt_work": "Model selection may remain manual. Declare the profile instead of pretending that a switch occurred.",
    "cli_or_sdk": "Map the selected CLI profile to a configured model ID before starting the task."
  }
}
